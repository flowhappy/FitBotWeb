Interval(time_it);\n        this.code_msg = \"点击获取验证码\";\n      }, 60000);\n      setTimeout(() => {\n        this.isSend = false;\n        this.code_msg = \"点击获取验证码\";\n      }, 60000);\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/sendMail.php\",\n          {\n            email: this.email,\n          },\n          {\n            headers: {\n              \"Content-Type\": \"application/x-www-form-urlencoded\",\n            },\n          }\n        )\n        .then((response) => {\n          if (response.data === 1) {\n            this.$message({\n              message: \"已经向您的邮箱发送了一封邮件\",\n              type: \"success\",\n            });\n          }\n        });\n    },\n    userSignup() {\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/signup.php\",\n          {\n            email: this.email,\n            pwd: this.password,\n            code: this.code,\n          },\n          {\n            headers: {\n              \"Content-Type\": \"application/x-www-form-urlencoded\",\n            },\n          }\n        )\n        .then((response) => {\n          if (response.data === \"wc\") {\n            this.$message.error(\"验证码错误！\");\n          } else if (response.data === 1) {\n            this.$message.error(\"该邮箱已被注册\");\n          } else if (response.data === 0) {\n            this.centerDialogVisible2 = false;\n            this.$message({\n              message: \"注册成功\",\n              type: \"success\",\n            });\n          } else {\n            this.$message({\n              message: \"出错了，再试一次\",\n              type: \"warning\",\n            });\n          }\n        });\n    },\n    userLogin() {\n      this.centerDialogVisible = false;\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/signin.php\",\n          {\n            email: this.email,\n            pwd: this.password,\n          },\n          {\n            headers: {\n              \"Content-Type\":