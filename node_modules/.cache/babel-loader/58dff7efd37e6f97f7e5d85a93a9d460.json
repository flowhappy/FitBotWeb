</h5>\n    </template>\n    <div class=\"row\">\n      <div class=\"col-md-5 pr-md-1 text-left\">\n        <base-input\n          label=\"Email\"\n          placeholder=\"example@example.com\"\n          v-model=\"user_email\"\n          disabled\n        >\n        </base-input>\n      </div>\n      <div class=\"col-md-3 px-md-1 text-left\">\n        <base-input label=\"Username\" placeholder=\"Username\" v-model=\"user_name\">\n        </base-input>\n      </div>\n      <div class=\"col-md-4 pl-md-1 text-left\">\n        <base-input\n          label=\"Gender\"\n          placeholder=\"male\"\n          v-model=\"user_gender\"\n          disabled\n        >\n        </base-input>\n      </div>\n    </div>\n\n    <div class=\"row\">\n      <div class=\"col-md-12 text-left\">\n        <base-input\n          label=\"Address\"\n          v-model=\"user_address\"\n          placeholder=\"Home Address\"\n        >\n        </base-input>\n      </div>\n    </div>\n\n    <div class=\"row\">\n      <div class=\"col-md-4 pr-md-1 text-left\">\n        <base-input\n          label=\"Weight\"\n          v-model=\"user_weight\"\n          placeholder=\"your weight\"\n        >\n        </base-input>\n      </div>\n      <div class=\"col-md-4 px-md-1 text-left\">\n        <base-input\n          label=\"Height\"\n          v-model=\"user_height\"\n          placeholder=\"your height\"\n        >\n        </base-input>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"col-md-4 pr-md-1 text-left\">\n        <base-input\n          label=\"Fat Percentage\"\n          v-model=\"user_fat_percentage\"\n          disabled\n        >\n        </base-input>\n      </div>\n      <div class=\"col-md-4 px-md-1 text-left\">\n        <base-input\n          label=\"Metabolism\"\n          v-model=\"user_metabolism\"\n          placeholder=\"your metabolism\"\n        >\n        </base-input>\n      </div>\n    </div>\n    <div class=\"row\">\n      <div class=\"col-md-8 text-left\">\n        <base-input>\n          <label>About Me</label>\n          <textarea\n            rows=\"4\"\n            cols=\"80\"\n            class=\"form-control\"\n            placeholder=\"Here can be your description\"\n            v-model=\"user_about\"\n          >\n          </textarea>\n        </base-input>\n      </div>\n    </div>\n    <template slot=\"footer\">\n      <base-button type=\"success\" fill @click=\"update_info\">Save</base-button>\n    </template>\n  </card>\n</template>\n<script>\nimport { Card, BaseInput } from \"@/components/index\";\nimport BaseButton from \"@/components/BaseButton\";\nimport { EventBus } from \"../../../event-bus.js\";\nimport axios from \"axios\";\nexport default {\n  components: {\n    Card,\n    BaseInput,\n    BaseButton,\n  },\n  props: {\n    model: {\n      type: Object,\n      default: () => {\n        return {};\n      },\n    },\n  },\n  data() {\n    return {\n      user_email: \"\",\n      user_name: \"\",\n      user_gender: \"\",\n      user_weight: \"\",\n      user_metabolism: \"\",\n      user_about: \"\",\n      user_height: \"\",\n      user_address: \"\",\n    };\n  },\n  mounted() {\n    let user_name = sessionStorage.getItem(\"name\");\n    if (!user_name) {\n      this.$message.error(\"请先登录\");\n      EventBus.$on(\"session_ready\", () => {\n        this.user_email = sessionStorage.getItem(\"email\");\n        this.user_name = sessionStorage.getItem(\"name\");\n        this.user_gender = sessionStorage.getItem(\"gender\") ? \"male\" : \"female\";\n        this.user_metabolism = sessionStorage.getItem(\"metabolism\");\n        this.user_about = sessionStorage.getItem(\"introduce\");\n        this.user_weight = sessionStorage.getItem(\"weight\");\n        this.user_height = sessionStorage.getItem(\"height\");\n        this.user_address = sessionStorage.getItem(\"address\");\n        this.user_fat_percentage =\n          (Number(this.user_weight) /\n            Number(this.user_height) /\n            Number(this.user_height)) *\n          10000;\n      });\n    } else {\n      this.user_email = sessionStorage.getItem(\"email\");\n      this.user_name = sessionStorage.getItem(\"name\");\n      this.user_gender = sessionStorage.getItem(\"gender\") ? \"male\" : \"female\";\n      this.user_metabolism = sessionStorage.getItem(\"metabolism\");\n      this.user_about = sessionStorage.getItem(\"introduce\");\n      this.user_weight = sessionStorage.getItem(\"weight\");\n      this.user_height = sessionStorage.getItem(\"height\");\n      this.user_address = sessionStorage.getItem(\"address\");\n      this.user_fat_percentage =\n        (Number(this.user_weight) /\n          Number(this.user_height) /\n          Number(this.user_height)) *\n        10000;\n    }\n  },\n  computed: {\n    user_fat_percentage: {\n      get() {\n        return (\n          (Number(this.user_weight) /\n            Number(this.user_height) /\n            Number(this.user_height)) *\n          10000\n        ).toFixed(1);\n      },\n\n      set() {\n        return (\n          (Number(this.user_weight) /\n            Number(this.user_height) /\n            Number(this.user_height)) *\n          10000\n        ).toFixed(1);\n      },\n    },\n  },\n  methods: {\n    update_info() {\n      if (!sessionStorage.getItem(\"email\")) {\n        this.$message.error(\"请先登录\");\n      }\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/updateUserInf.php\",\n          {\n            email: this.user_email,\n            name: this.user_name,\n            weight: this.user_weight,\n            height: this.user_height,\n            address: this.user_address,\n            introduce: this.user_about,\n            metabolism: this.user_metabolism,\n            fat_percentage: this.user_fat_percentage,\n            month: new Date().getMonth() + 1,\n          },\n          {\n            headers: {\n              \"Content-Type\": \"application/x-www-form-urlencoded\",\n            },\n          }\n        )\n        .then((response) => {\n          if (response.status === 200) {\n            sessionStorage.setItem(\"name\", this.user_name);\n            sessionStorage.setItem(\"metabolism\", this.user_metabolism);\n            sessionStorage.setItem(\"introduce\", this.user_about);\n            sessionStorage.setItem(\"weight\", this.user_weight);\n            sessionStorage.setItem(\"height\", this.user_height);\n            sessionStorage.setItem(\"address\", this.user_address);\n            axios\n              .post(\n                \"https://www.lloydyide.cn/fitbotAPI/getUserMInf.php\",\n                {\n                  email: sessionStorage.getItem(\"email\"),\n                },\n                {\n                  headers: {\n                    \"Content-Type\": \"application/x-www-form-urlencoded\",\n                  },\n                }\n              )\n              .then((response) => {\n                console.log(\"Response:\", response.data[0]); // 请求成功时的处理\n                const res_data = response.data[0];\n                let user_monthly_info = [];\n                const weightValues = Object.keys(res_data)\n                  .filter((key) => /^weight_\\d+$/.test(key)) // 过滤出以 weight_ 开头的字段\n                  .map((key) => res_data[key]); // 提取对应的值\n                user_monthly_info.push(weightValues);\n\n                const accuracyValues = Object.keys(res_data)\n                  .filter((key) => /^accuracy_\\d+$/.test(key)) // 过滤出以 weight_ 开头的字段\n                  .map((key) => res_data[key]); // 提取对应的值\n                user_monthly_info.push(accuracyValues);\n\n                const fat_percentageValues = Object.keys(res_data)\n                  .filter((key) => /^fat_percentage_\\d+$/.test(key)) // 过滤出以 weight_ 开头的字段\n                  .map((key) => res_data[key]); // 提取对应的值\n                user_monthly_info.push(fat_percentageValues);\n\n                const timeValues = Object.keys(res_data)\n                  .filter((key) => /^time_\\d+$/.test(key)) // 过滤出以 weight_ 开头的字段\n                  .map((key) => res_data[key]); // 提取对应的值\n                user_monthly_info.push(timeValues);\n                sessionStorage.setItem(\"umf\", user_monthly_info);\n                this.$message.success(\"更新成功\");\n              })\n              .catch((error) => {\n                console.error(\"Error:\", error); // 请求失败时的处理\n              });\n          }\n        })\n        .catch((error) => {\n          console.log(error);\n        });\n    },\n  },\n};\n</script>\n<style></style>\n"],"mappings":";;;AAkGA,SAAAA,IAAA,EAAAC,SAAA;AACA,OAAAC,UAAA;AACA,SAAAC,QAAA;AACA,OAAAC,KAAA;AACA;EACAC,UAAA;IACAL,IAAA,EAAAA,IAAA;IACAC,SAAA,EAAAA,SAAA;IACAC,UAAA,EAAAA;EACA;EACAI,KAAA;IACAC,KAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA,WAAAA,SAAA;QACA;MACA;IACA;EACA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,UAAA;MACAC,SAAA;MACAC,WAAA;MACAC,WAAA;MACAC,eAAA;MACAC,UAAA;MACAC,WAAA;MACAC,YAAA;IACA;EACA;EACAC,OAAA,WAAAA,QAAA;IAAA,IAAAC,KAAA;IACA,IAAAR,SAAA,GAAAS,cAAA,CAAAC,OAAA;IACA,KAAAV,SAAA;MACA,KAAAW,QAAA,CAAAC,KAAA;MACAtB,QAAA,CAAAuB,GAAA;QACAL,KAAA,CAAAT,UAAA,GAAAU,cAAA,CAAAC,OAAA;QACAF,KAAA,CAAAR,SAAA,GAAAS,cAAA,CAAAC,OAAA;QACAF,KAAA,CAAAP,WAAA,GAAAQ,cAAA,CAAAC,OAAA;QACAF,KAAA,CAAAL,eAAA,GAAAM,cAAA,CAAAC,OAAA;QACAF,KAAA,CAAAJ,UAAA,GAAAK,cAAA,CAAAC,OAAA;QACAF,KAAA,CAAAN,WAAA,GAAAO,cAAA,CAAAC,OAAA;QACAF,KAAA,CAAAH,WAAA,GAAAI,cAAA,CAAAC,OAAA;QACAF,KAAA,CAAAF,YAAA,GAAAG,cAAA,CAAAC,OAAA;QACAF,KAAA,CAAAM,mBAAA,GACAC,MAAA,CAAAP,KAAA,CAAAN,WAAA,IACAa,MAAA,CAAAP,KAAA,CAAAH,WAAA,IACAU,MAAA,CAAAP,KAAA,CAAAH,WAAA,IACA;MACA;IACA;MACA,KAAAN,UAAA,GAAAU,cAAA,CAAAC,OAAA;MACA,KAAAV,SAAA,GAAAS,cAAA,CAAAC,OAAA;MACA,KAAAT,WAAA,GAAAQ,cAAA,CAAAC,OAAA;MACA,KAAAP,eAAA,GAAAM,cAAA,CAAAC,OAAA;MACA,KAAAN,UAAA,GAAAK,cAAA,CAAAC,OAAA;MACA,KAAAR,WAAA,GAAAO,cAAA,CAAAC,OAAA;MACA,KAAAL,WAAA,GAAAI,cAAA,CAAAC,OAAA;MACA,KAAAJ,YAAA,GAAAG,cAAA,CAAAC,OAAA;MACA,KAAAI,mBAAA,GACAC,MAAA,MAAAb,WAAA,IACAa,MAAA,MAAAV,WAAA,IACAU,MAAA,MAAAV,WAAA,IACA