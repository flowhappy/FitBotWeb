</slot>\n    <div class=\"card-footer text-left\" v-if=\"$slots.footer\">\n      <slot name=\"footer\"></slot>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  name: \"card\",\n  props: {\n    title: String,\n    subTitle: String,\n    type: String,\n    icon: String,\n  },\n  computed: {\n    isRTL() {\n      return this.$rtl.isRTL;\n    },\n  },\n};\n</script>\n<style></style>\n"]}]}