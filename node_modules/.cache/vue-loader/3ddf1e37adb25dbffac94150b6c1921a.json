{"remainingRequest":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/liuyide/Desktop/FitBotWeb/src/pages/TableList.vue?vue&type=template&id=0b9c9cd0","dependencies":[{"path":"/Users/liuyide/Desktop/FitBotWeb/src/pages/TableList.vue","mtime":1747061012915},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/babel-loader/lib/index.js","mtime":1743054315148},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/loaders/templateLoader.js","mtime":1743054315709},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js","mtime":1743054315359}],"contextDependencies":[],"result":["\n<div class=\"content\">\n  <div class=\"row\">\n    <div class=\"col-12\">\n      <card style=\"height: 86vh; overflow: scroll\">\n        <template slot=\"header\">\n          <h4 class=\"card-title\">文章列表</h4>\n        </template>\n        <div class=\"table-responsive text-left\">\n          <base-table\n            :data=\"table1.data\"\n            :columns=\"table1.columns\"\n            thead-classes=\"text-primary\"\n            @row-click=\"handleRowClick\"\n          >\n          </base-table>\n        </div>\n      </card>\n    </div>\n\n    <el-drawer\n      :withHeader=\"false\"\n      :visible.sync=\"drawer\"\n      direction=\"ttb\"\n      size=\"100%\"\n      :append-to-body=\"true\"\n      custom-class=\"article-detail-drawer\"\n    >\n      <!-- 确保 selectedArticle 有数据后再渲染内部结构 -->\n      <div v-if=\"selectedArticle\" class=\"drawer-layout\">\n        <!-- 关闭按钮 -->\n        <el-button\n          type=\"info\"\n          icon=\"el-icon-close\"\n          circle\n          class=\"close-button\"\n          @click=\"drawer = false\"\n        ></el-button>\n        <div class=\"image-pane\">\n          <el-carousel\n            :interval=\"5000\"\n            arrow=\"always\"\n            height=\"100%\"\n            class=\"image-carousel\"\n            ref=\"imageCarousel\"\n          >\n            <el-carousel-item\n              v-for=\"(imgUrl, index) in selectedArticle.imageUrls\"\n              :key=\"index\"\n            >\n              <!-- 让图片填充轮播项，并保持比例 -->\n              <img\n                :src=\"imgUrl.pic_url\"\n                :alt=\"'文章图片 ' + imgUrl\"\n                class=\"carousel-image\"\n              />\n            </el-carousel-item>\n          </el-carousel>\n        </div>\n\n        <!-- 右侧内容和评论区域 -->\n        <div class=\"details-pane\">\n          <!-- 上部：内容 -->\n          <div class=\"content-section\">\n            <h3 style=\"font-weight: bolder\">{{ selectedArticle.title }}</h3>\n            <div class=\"content-text-area\">\n              {{ selectedArticle.content }}\n            </div>\n          </div>\n\n          <!-- 下部：评论 -->\n          <div class=\"comments-section\">\n            <h5 style=\"color: black\">\n              共{{ selectedArticle.commit_num }}条评论：\n            </h5>\n\n            <div>\n              <el-input\n                placeholder=\"说点什么...\"\n                v-model=\"user_comment\"\n                class=\"input-with-select\"\n              >\n                <el-button\n                  slot=\"append\"\n                  icon=\"el-icon-s-promotion\"\n                  @click=\"judgeComment\"\n                  >发送</el-button\n                >\n              </el-input>\n            </div>\n\n            <div class=\"comments-list-area\">\n              <!-- 替换 selectedArticle.comments 为你的实际评论数组属性 -->\n              <ul\n                v-if=\"Array.isArray(commitInf) && commitInf.length > 0\"\n                class=\"comment-list\"\n              >\n                <li\n                  v-for=\"(comment, index) in commitInf\"\n                  :key=\"index\"\n                  class=\"comment-item\"\n                >\n                  <!-- 左侧内容区 (占位较多) -->\n                  <div class=\"comment-left\">\n                    <div class=\"comment-user\">\n                      {{ comment.user_name || \"匿名用户\" }}\n                    </div>\n                    <div class=\"comment-content\">\n                      {{ comment.content }}\n                    </div>\n                    <div class=\"comment-meta\">\n                      <span class=\"comment-date\">{{ comment.date }}</span>\n                      <span v-if=\"comment.location\" class=\"comment-location\">\n                        · {{ comment.location }}</span\n                      >\n                      <span\n                        style=\"\n                          margin-left: 1vw;\n                          color: #ff6b6b;\n                          cursor: pointer;\n                        \"\n                        v-if=\"comment.is_own\"\n                        @click=\"delete_comment(comment.id)\"\n                        >删除</span\n                      >\n                    </div>\n                  </div>\n\n                  <!-- 右侧点赞区 (占位较少) -->\n                  <div class=\"comment-right\">\n                    <span class=\"comment-star\">\n                      <i\n                        class=\"el-icon-star-on\"\n                        style=\"color: #ffc107; font-size: 2rem\"\n                        @click=\"\n                          likeComment(\n                            commitInf[index].id,\n                            commitInf[index].star\n                          )\n                        \"\n                      ></i>\n                      {{ comment.star }}\n                    </span>\n                  </div>\n                </li>\n              </ul>\n              <p v-else class=\"no-comments\">暂无评论</p>\n            </div>\n          </div>\n\n          <!-- 建议将以下 CSS 添加到你的 <style> 标签或 CSS 文件中 -->\n        </div>\n      </div>\n\n      <!-- selectedArticle 为空时的占位提示 -->\n      <div v-else class=\"drawer-placeholder\">\n        <p>请先在表格中选择一篇文章以查看详情。</p>\n      </div>\n    </el-drawer>\n  </div>\n</div>\n",null]}