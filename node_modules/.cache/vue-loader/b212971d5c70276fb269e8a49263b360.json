{"remainingRequest":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/liuyide/Desktop/FitBotWeb/src/components/eCharts.vue?vue&type=script&lang=js","dependencies":[{"path":"/Users/liuyide/Desktop/FitBotWeb/src/components/eCharts.vue","mtime":1743864627124},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/babel-loader/lib/index.js","mtime":1743054315148},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js","mtime":1743054315359}],"contextDependencies":[],"result":["\n// 2. 引入 ECharts (最简单的全局引入)\nimport * as echarts from 'echarts';\n\nexport default {\n  name: 'SimpleChart',\n  // 3. 在 DOM 挂载后初始化图表\n  mounted() {\n    // 基于准备好的 DOM，初始化 ECharts 实例\n    // this.$refs.chart 获取到模板中 ref=\"chart\" 的 DOM 元素\n    const chartDom = this.$refs.chart;\n\n    if (chartDom) {\n      const myChart = echarts.init(chartDom);\n\n      // 4. 定义图表配置项\n      const option = {\n        title: {\n          text: '最简 ECharts 示例'\n        },\n        tooltip: {},\n        xAxis: {\n          data: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']\n        },\n        yAxis: {},\n        series: [\n          {\n            name: 'Data',\n            type: 'bar', // 柱状图\n            data: [120, 200, 150, 80, 70, 110, 130]\n          }\n        ]\n      };\n\n      // 5. 使用配置项显示图表\n      myChart.setOption(option);\n\n    } else {\n      console.error(\"图表容器 'chart' 未找到!\");\n    }\n  }\n  // 注意：此最简示例省略了 beforeDestroy 中的图表销毁 (dispose)\n  // 和窗口 resize 事件监听，这在复杂应用中可能导致内存泄漏或显示问题。\n};\n",{"version":3,"sources":["eCharts.vue"],"names":[],"mappings":";AAMA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA","file":"eCharts.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <!-- 1. 必须的容器，需要设置宽高 -->\n  <div ref=\"chart\" style=\"width: 400px; height: 300px;\"></div>\n</template>\n\n<script>\n// 2. 引入 ECharts (最简单的全局引入)\nimport * as echarts from 'echarts';\n\nexport default {\n  name: 'SimpleChart',\n  // 3. 在 DOM 挂载后初始化图表\n  mounted() {\n    // 基于准备好的 DOM，初始化 ECharts 实例\n    // this.$refs.chart 获取到模板中 ref=\"chart\" 的 DOM 元素\n    const chartDom = this.$refs.chart;\n\n    if (chartDom) {\n      const myChart = echarts.init(chartDom);\n\n      // 4. 定义图表配置项\n      const option = {\n        title: {\n          text: '最简 ECharts 示例'\n        },\n        tooltip: {},\n        xAxis: {\n          data: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']\n        },\n        yAxis: {},\n        series: [\n          {\n            name: 'Data',\n            type: 'bar', // 柱状图\n            data: [120, 200, 150, 80, 70, 110, 130]\n          }\n        ]\n      };\n\n      // 5. 使用配置项显示图表\n      myChart.setOption(option);\n\n    } else {\n      console.error(\"图表容器 'chart' 未找到!\");\n    }\n  }\n  // 注意：此最简示例省略了 beforeDestroy 中的图表销毁 (dispose)\n  // 和窗口 resize 事件监听，这在复杂应用中可能导致内存泄漏或显示问题。\n};\n</script>\n\n<style scoped>\n/* 可以添加一些样式 */\n</style>\n"]}]}