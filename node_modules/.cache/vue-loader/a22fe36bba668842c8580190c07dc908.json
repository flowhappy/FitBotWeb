order-radius: 8px; /* 轻微圆角 */\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* 添加阴影增加立体感 */\n}\n.image-carousel {\n  width: 100%; /* 轮播图宽度占满 image-pane */\n  height: 100%; /* 轮播图高度占满 image-pane */\n}\n\n/* 设置轮播图中图片本身的样式 */\n.carousel-image {\n  width: 100%;\n  height: 100%;\n  object-fit: contain; /* 图片保持比例缩放，完整显示在容器内 */\n  /* 你也可以用 'cover'，图片会填满容器，可能会裁剪 */\n  display: block; /* 消除图片下方的微小间隙 */\n  border-radius: 6px; /* 给图片加点圆角 */\n}\n/* 调整箭头按钮 */\n:deep(.image-carousel .el-carousel__arrow) {\n  background-color: rgba(31, 45, 61, 0.7); /* 半透明背景 */\n  width: 40px;\n  height: 40px;\n  font-size: 18px;\n}\n:deep(.image-carousel .el-carousel__arrow--left) {\n  left: 15px; /* 调整左箭头位置 */\n}\n:deep(.image-carousel .el-carousel__arrow--right) {\n  right: 15px; /* 调整右箭头位置 */\n}\n\n/* 调整指示器 */\n:deep(.image-carousel .el-carousel__indicators--outside) {\n  bottom: 10px; /* 指示器距离底部距离 */\n}\n:deep(.image-carousel .el-carousel__indicator button) {\n  background-color: #ced4da; /* 指示器非激活颜色 */\n  opacity: 0.8;\n  width: 10px; /* 可以调小一点 */\n  height: 10px;\n  border-radius: 50%;\n}\n:deep(.image-carousel .el-carousel__indicator.is-active button) {\n  background-color: #007bff; /* 指示器激活颜色 */\n  opacity: 1;\n}\n.image-placeholder {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #adb5bd; /* 占位文字颜色 */\n  background-color: #e9ecef; /* 占位背景色 */\n  border-radius: 8px;\n  font-size: 1.2em;\n}\n\n/* 右侧详情面板 */\n.details-pane {\n  flex: 0 0 50%; /* 固定宽度为50% */\n  display: flex;\n  flex-direction: column; /* 垂直排列：上内容下评论 */\n  height: 100%;\n  overflow: hidden; /* 防止内部滚动影响外部 */\n}\n\n/* 内容区域 */\n.content-section {\n  /* flex-grow: 1; 让内容区尽可能填充空间，但要考虑最小高度 */\n  min-height: 20vh; /* 内容区域最小高度 */\n  padding: 25px; /* 增加内边距 */\n  box-sizing: border-box;\n  overflow-y: auto; /* 内容过多时允许滚动 */\n  flex-shrink: 0; /* 防止被评论区过度压缩 */\n  border-bottom: 1px solid #dee2e6; /* 底部边框分割线 */\n  background-color: #ffffff; /* 内容区白色背景 */\n}\n\n.content-section h3 {\n  margin-top: 0;\n  margin-bottom: 15px;\n  color: #343a40;\n  font-size: 1.4em;\n}\n\n.content-text-area {\n  line-height: 1.6;\n  color: #495057;\n}\n\n/* 评论区域 */\n.comments-section {\n  flex-grow: 1; /* 占据剩余空间 */\n  padding: 25px;\n  box-sizing: border-box;\n  overflow-y: auto; /* 评论过多时允许滚动 */\n  display: flex; /* 使用flex布局方便控制内部滚动 */\n  flex-direction: column; /* 垂直排列标题和列表 */\n  background-color: #f1f3f5; /* 评论区稍暗背景 */\n}\n\n.comments-section h3 {\n  margin-top: 0;\n  margin-bottom: 15px;\n  color: #343a40;\n  font-size: 1.3em;\n  flex-shrink: 0; /* 标题不收缩 */\n}\n\n.comments-list-area {\n  flex-grow: 1; /* 列表区域占据剩余空间 */\n  overflow-y: auto; /* 列表内容滚动 */\n}\n\n.comment-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.comment-item {\n  padding: 10px 0;\n  border-bottom: 1px dashed #ced4da; /* 评论间虚线分隔 */\n  color: #495057;\n}\n.comment-item:last-child {\n  border-bottom: none; /* 最后一个评论项无下边框 */\n}\n.comment-item strong {\n  color: #007bff; /* 评论者名字颜色 */\n}\n\n.no-comments {\n  color: #6c757d;\n  font-style: italic;\n}\n\n/* selectedArticle 为空时的占位符样式 */\n.drawer-placeholder {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #6c757d;\n  font-size: 1.1em;\n  text-align: center;\n  padding: 20px;\n  box-sizing: border-box;\n}\n",{"version":3,"sources":["TableList.vue"],"names":[],"mappings":";AA6LA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"TableList.vue","sourceRoot":"src/pages","sourcesContent":["<template>\n  <div class=\"content\">\n    <div class=\"row\">\n      <div class=\"col-12\">\n        <card>\n          <template slot=\"header\">\n            <h4 class=\"card-title\">可点击行的简单表格</h4>\n          </template>\n          <div class=\"table-responsive text-left\">\n            <base-table\n              :data=\"table1.data\"\n              :columns=\"table1.columns\"\n              thead-classes=\"text-primary\"\n              @row-click=\"handleRowClick\"\n            >\n            </base-table>\n          </div>\n        </card>\n      </div>\n\n      <el-drawer\n        :withHeader=\"false\"\n        :visible.sync=\"drawer\"\n        direction=\"ttb\"\n        size=\"100%\"\n        :append-to-body=\"true\"\n        custom-class=\"article-detail-drawer\"\n      >\n        <!-- 确保 selectedArticle 有数据后再渲染内部结构 -->\n        <div v-if=\"selectedArticle\" class=\"drawer-layout\">\n          <!-- 关闭按钮 -->\n          <el-button\n            type=\"info\"\n            icon=\"el-icon-close\"\n            circle\n            class=\"close-button\"\n            @click=\"drawer = false\"\n          ></el-button>\n          <div class=\"image-pane\">\n            <el-carousel\n              v-if=\"\n                Array.isArray(selectedArticle.imageUrls) &&\n                selectedArticle.imageUrls.length > 0\n              \"\n              :interval=\"5000\"\n              arrow=\"always\"\n              height=\"100%\"\n              class=\"image-carousel\"\n              ref=\"imageCarousel\"\n            >\n              <el-carousel-item\n                v-for=\"(imgUrl, index) in selectedArticle.imageUrls\"\n                :key=\"index\"\n              >\n                <!-- 让图片填充轮播项，并保持比例 -->\n                <img\n                  :src=\"imgUrl\"\n                  :alt=\"'文章图片 ' + (index + 1)\"\n                  class=\"carousel-image\"\n                />\n              </el-carousel-item>\n            </el-carousel>\n\n            <!-- 如果没有有效的图片数组，则显示占位符 -->\n            <div v-else class=\"image-placeholder\">无图片</div>\n          </div>\n\n          <!-- 右侧内容和评论区域 -->\n          <div class=\"details-pane\">\n            <!-- 上部：内容 -->\n            <div class=\"content-section\">\n              <h3>文章内容</h3>\n              <div class=\"content-text-area\">\n                <!-- 替换 selectedArticle.content 为你的实际内容属性 -->\n                <p v-if=\"selectedArticle.content\">\n                  {{ selectedArticle.content }}\n                </p>\n                <p v-else>暂无内容</p>\n              </div>\n            </div>\n\n            <!-- 下部：评论 -->\n            <div class=\"comments-section\">\n              <h3>评论区</h3>\n              <div class=\"comments-list-area\">\n                <!-- 替换 selectedArticle.comments 为你的实际评论数组属性 -->\n                <ul\n                  v-if=\"\n                    Array.isArray(selectedArticle.comments) &&\n                    selectedArticle.comments.length > 0\n                  \"\n                  class=\"comment-list\"\n                >\n                  <!-- 假设评论对象有 author 和 text 属性, 请按需替换 -->\n                  <li\n                    v-for=\"(comment, index) in selectedArticle.comments\"\n                    :key=\"index\"\n                    class=\"comment-item\"\n                  >\n                    <p>\n                      <strong>{{ comment.author || \"匿名用户\" }}:</strong>\n                      {{ comment.text }}\n                    </p>\n                  </li>\n                </ul>\n                <p\n                  v-else-if=\"\n                    typeof selectedArticle.comments === 'string' &&\n                    selectedArticle.comments.trim()\n                  \"\n                >\n                  {{ selectedArticle.comments }}\n                </p>\n                <p v-else class=\"no-comments\">暂无评论</p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- selectedArticle 为空时的占位提示 -->\n        <div v-else class=\"drawer-placeholder\">\n          <p>请先在表格中选择一篇文章以查看详情。</p>\n        </div>\n      </el-drawer>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Card } from \"@/components/index\";\nimport BaseTable from \"@/components/BaseTable\";\nimport axios from \"axios\";\n// import { Drawer } from 'element-ui';\n\nexport default {\n  name: \"YourComponentName\",\n  components: {\n    Card,\n    BaseTable,\n    // ElDrawer: Drawer,\n  },\n  data() {\n    return {\n      drawer: false,\n      selectedArticle: null,\n      table1: {\n        title: \"简单表格\",\n        columns: [\"title\", \"intro\", \"commit_num\"],\n        data: [],\n      },\n    };\n  },\n  mounted() {\n    this.fetchTable1Data();\n  },\n  methods: {\n    fetchTable1Data() {\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/getArticleInf.php\",\n          {},\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          if (Array.isArray(response.data)) {\n            this.table1.data = response.data;\n          } else {\n            console.error(\"API 返回的不是数组:\", response.data);\n            this.table1.data = [];\n          }\n        })\n        .catch((error) => {\n          console.error(\"获取表格数据时出错:\", error);\n          this.table1.data = [];\n        });\n    },\n\n    // 在父组件的 <script> methods 中\n    handleRowClick(item) {\n      console.log(\"点击的行数据:\", item); // <--- 添加这行来查看数据\n      this.selectedArticle = item;\n      this.selectedArticle.imageUrls = [1,2,3,4,5]\n      this.drawer = true;\n    },\n  },\n};\n</script>\n\n<style>\n/* 为抽屉添加一个自定义类，方便进行样式覆盖和限定范围 */\n:deep(.article-detail-drawer .el-drawer__body) {\n  padding: 0; /* 移除 Element UI 默认的 body padding */\n  overflow: hidden; /* 防止内部元素溢出导致滚动条出现问题 */\n  height: 100%;\n  display: flex; /* 使用 flex 布局 */\n}\n\n.drawer-layout {\n  position: relative; /* 父容器需要相对定位，以便绝对定位的子元素相对于它定位 */\n  display: flex;\n  flex-direction: row;\n  width: 100%;\n  height: 100%;\n  background-color: #f8f9fa;\n}\n\n.close-button {\n  position: absolute; /* 使用绝对定位 */\n  top: 20px; /* 距离顶部 20px */\n  left: 20px; /* 距离左侧 20px */\n  z-index: 10; /* 确保按钮在其他内容之上 */\n}\n/* 左侧图片面板 */\n.image-pane {\n  flex: 0 0 50%; /* 保持原有的宽度设置 */\n  padding: 4.5vw; /* 可以适当减少内边距，给轮播图更多空间 */\n  box-sizing: border-box;\n  display: flex; /* 仍然使用flex来居中占位符 */\n  align-items: center;\n  justify-content: center;\n  overflow: hidden; /* 防止轮播图溢出 */\n  border-right: 1px solid #dee2e6;\n  /* background-color: #f0f0f0; /* 可以给图片区域加个浅色背景 */\n  position: relative; /* 添加相对定位，如果需要绝对定位内部元素 */\n}\n\n.article-image {\n  max-width: 100%;\n  max-height: 100%;\n  height: auto; /* 高度自适应 */\n  object-fit: contain; /* 保持图片比例，完整显示 */\n  border-radius: 8px; /* 轻微圆角 */\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* 添加阴影增加立体感 */\n}\n.image-carousel {\n  width: 100%; /* 轮播图宽度占满 image-pane */\n  height: 100%; /* 轮播图高度占满 image-pane */\n}\n\n/* 设置轮播图中图片本身的样式 */\n.carousel-image {\n  width: 100%;\n  height: 100%;\n  object-fit: contain; /* 图片保持比例缩放，完整显示在容器内 */\n  /* 你也可以用 'cover'，图片会填满容器，可能会裁剪 */\n  display: block; /* 消除图片下方的微小间隙 */\n  border-radius: 6px; /* 给图片加点圆角 */\n}\n/* 调整箭头按钮 */\n:deep(.image-carousel .el-carousel__arrow) {\n  background-color: rgba(31, 45, 61, 0.7); /* 半透明背景 */\n  width: 40px;\n  height: 40px;\n  font-size: 18px;\n}\n:deep(.image-carousel .el-carousel__arrow--left) {\n  left: 15px; /* 调整左箭头位置 */\n}\n:deep(.image-carousel .el-carousel__arrow--right) {\n  right: 15px; /* 调整右箭头位置 */\n}\n\n/* 调整指示器 */\n:deep(.image-carousel .el-carousel__indicators--outside) {\n  bottom: 10px; /* 指示器距离底部距离 */\n}\n:deep(.image-carousel .el-carousel__indicator button) {\n  background-color: #ced4da; /* 指示器非激活颜色 */\n  opacity: 0.8;\n  width: 10px; /* 可以调小一点 */\n  height: 10px;\n  border-radius: 50%;\n}\n:deep(.image-carousel .el-carousel__indicator.is-active button) {\n  background-color: #007bff; /* 指示器激活颜色 */\n  opacity: 1;\n}\n.image-placeholder {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #adb5bd; /* 占位文字颜色 */\n  background-color: #e9ecef; /* 占位背景色 */\n  border-radius: 8px;\n  font-size: 1.2em;\n}\n\n/* 右侧详情面板 */\n.details-pane {\n  flex: 0 0 50%; /* 固定宽度为50% */\n  display: flex;\n  flex-direction: column; /* 垂直排列：上内容下评论 */\n  height: 100%;\n  overflow: hidden; /* 防止内部滚动影响外部 */\n}\n\n/* 内容区域 */\n.content-section {\n  /* flex-grow: 1; 让内容区尽可能填充空间，但要考虑最小高度 */\n  min-height: 20vh; /* 内容区域最小高度 */\n  padding: 25px; /* 增加内边距 */\n  box-sizing: border-box;\n  overflow-y: auto; /* 内容过多时允许滚动 */\n  flex-shrink: 0; /* 防止被评论区过度压缩 */\n  border-bottom: 1px solid #dee2e6; /* 底部边框分割线 */\n  background-color: #ffffff; /* 内容区白色背景 */\n}\n\n.content-section h3 {\n  margin-top: 0;\n  margin-bottom: 15px;\n  color: #343a40;\n  font-size: 1.4em;\n}\n\n.content-text-area {\n  line-height: 1.6;\n  color: #495057;\n}\n\n/* 评论区域 */\n.comments-section {\n  flex-grow: 1; /* 占据剩余空间 */\n  padding: 25px;\n  box-sizing: border-box;\n  overflow-y: auto; /* 评论过多时允许滚动 */\n  display: flex; /* 使用flex布局方便控制内部滚动 */\n  flex-direction: column; /* 垂直排列标题和列表 */\n  background-color: #f1f3f5; /* 评论区稍暗背景 */\n}\n\n.comments-section h3 {\n  margin-top: 0;\n  margin-bottom: 15px;\n  color: #343a40;\n  font-size: 1.3em;\n  flex-shrink: 0; /* 标题不收缩 */\n}\n\n.comments-list-area {\n  flex-grow: 1; /* 列表区域占据剩余空间 */\n  overflow-y: auto; /* 列表内容滚动 */\n}\n\n.comment-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n.comment-item {\n  padding: 10px 0;\n  border-bottom: 1px dashed #ced4da; /* 评论间虚线分隔 */\n  color: #495057;\n}\n.comment-item:last-child {\n  border-bottom: none; /* 最后一个评论项无下边框 */\n}\n.comment-item strong {\n  color: #007bff; /* 评论者名字颜色 */\n}\n\n.no-comments {\n  color: #6c757d;\n  font-style: italic;\n}\n\n/* selectedArticle 为空时的占位符样式 */\n.drawer-placeholder {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #6c757d;\n  font-size: 1.1em;\n  text-align: center;\n  padding: 20px;\n  box-sizing: border-box;\n}\n</style>\n"]}]}