{"remainingRequest":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/liuyide/Desktop/FitBotWeb/src/components/eCharts2.vue?vue&type=style&index=0&id=e70edb30&scoped=true&lang=css","dependencies":[{"path":"/Users/liuyide/Desktop/FitBotWeb/src/components/eCharts2.vue","mtime":1743868216284},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/css-loader/index.js","mtime":1743054314550},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1743054315691},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/postcss-loader/src/index.js","mtime":1743054315143},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js","mtime":1743054315359}],"contextDependencies":[],"result":["\n/* Add styles for .loading-message if needed */\n.error-message {\n  padding: 10px;\n  color: red;\n  text-align: center;\n}\n",{"version":3,"sources":["eCharts2.vue"],"names":[],"mappings":";AAkOA;AACA;AACA;AACA;AACA;AACA","file":"eCharts2.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <div>\n    <div\n      ref=\"chart\"\n      v-show=\"!isLoading && !error\"\n      style=\"width: 35vw; height: 40vh\"\n    ></div>\n  </div>\n</template>\n\n<script>\nimport * as echarts from \"echarts\";\nimport axios from \"axios\";\n\n// 提前定义好月份名称，用于饼图的 name\nconst MONTH_NAMES = [\n  \"JAN\",\n  \"FEB\",\n  \"MAR\",\n  \"APR\",\n  \"MAY\",\n  \"JUN\",\n  \"JUL\",\n  \"AUG\",\n  \"SEP\",\n  \"OCT\",\n  \"NOV\",\n  \"DEC\",\n];\n\nexport default {\n  name: \"echarts2\", // 改个名表示是饼图\n  data() {\n    return {\n      chartInstance: null,\n      isLoading: false,\n      error: null,\n      boundResizeHandler: null,\n    };\n  },\n  mounted() {\n    this.initChart();\n    this.fetchAndUpdateChart();\n    this.boundResizeHandler = this.handleResize.bind(this);\n    window.addEventListener(\"resize\", this.boundResizeHandler);\n  },\n  beforeDestroy() {\n    if (this.chartInstance) {\n      this.chartInstance.dispose();\n      this.chartInstance = null;\n    }\n    if (this.boundResizeHandler) {\n      window.removeEventListener(\"resize\", this.boundResizeHandler);\n    }\n  },\n  methods: {\n    // 初始化图表方法 - 饼图配置\n    initChart() {\n      const chartDom = this.$refs.chart;\n      if (chartDom && !this.chartInstance) {\n        this.chartInstance = echarts.init(chartDom);\n\n        // --- 饼图的初始配置 ---\n        const initialOption = {\n\n          title: {\n            text: \"用户月度训练时长分布\", // 修改标题\n            left: \"center\", // 标题居中\n            textStyle: { color: \"#000000\" }, // 假设标题为白色\n          },\n          tooltip: {\n            trigger: \"item\", // 饼图通常用 item 触发\n            formatter: \"{a} <br/>{b} : {c} ({d}%)\", // a: 系列名, b: 数据名, c: 数值, d: 百分比\n          },\n          legend: {\n            // 添加图例组件\n            show: false,\n            orient: \"vertical\", // 垂直布局\n            left: \"left\", // 放在左边\n            top: \"middle\", // 垂直居中\n            data: MONTH_NAMES, // 图例数据，即月份名称\n            textStyle: { color: \"#000000\" }, // 假设图例文字为白色\n          },\n          series: [\n            {\n              name: \"训练时长\", // 系列名称，对应 tooltip 的 {a}\n              type: \"pie\", // *** 类型改为 pie ***\n              radius: [\"40%\", \"70%\"],\n              center: [\"50%\", \"50%\"], // 将饼图调整到容器中心\n              data: [], // 初始数据为空\n              emphasis: {\n                // 鼠标悬浮时的样式\n                itemStyle: {\n                  shadowBlur: 10,\n                  shadowOffsetX: 0,\n                  shadowColor: \"rgba(0, 0, 0, 0.5)\",\n                },\n              },\n              label: {\n                // 饼图图形上的文本标签\n                // show: false, // 可以选择不显示标签\n                formatter: \"{b}: {d}%\", // 显示名称和百分比\n                color: \"#000000\", // 假设标签文字为白色\n              },\n              labelLine: {\n                // 标签引导线样式\n                smooth: 0.2,\n                length: 10,\n                length2: 20,\n              },\n              itemStyle: {\n                // 可以设置颜色等\n                // ECharts 会自动分配颜色，也可以自定义\n                borderRadius: 8, // 给扇区加圆角\n              },\n            },\n          ],\n          // --- 移除 xAxis, yAxis, grid ---\n        };\n        // --- 饼图配置结束 ---\n\n        this.chartInstance.setOption(initialOption);\n      } else if (!chartDom) {\n        console.error(\"EchartsPie: 图表容器 'chart' 未找到!\");\n      }\n    },\n\n    // 获取数据并更新图表的方法\n    fetchAndUpdateChart() {\n      if (this.isLoading) return;\n      this.isLoading = true;\n      this.error = null;\n      const userEmail = sessionStorage.getItem(\"email\");\n\n      if (!userEmail) {\n        this.error = \"未找到用户信息\";\n        this.isLoading = false;\n        console.error(\"EchartsPie: 无法从 sessionStorage 获取 email\");\n        return;\n      }\n\n      axios\n        .post(\n          /* ... */\n          \"https://www.lloydyide.cn/fitbotAPI/getUserMInf.php\",\n          { email: userEmail },\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          console.log(\"EchartsPie Response:\", response.data);\n          if (response.data && response.data.length > 0) {\n            const res_data = response.data[0];\n\n            // 提取 time_ 数据，仍然是数值数组\n            const timeValuesRaw = Object.keys(res_data)\n              .filter((key) => /^time_\\d+$/.test(key))\n              // (可选) 排序确保顺序与月份对应\n              .sort(\n                (a, b) =>\n                  parseInt(a.split(\"_\")[1], 10) - parseInt(b.split(\"_\")[1], 10)\n              )\n              .map((key) => parseFloat(res_data[key]) || 0); // 确保是数字\n\n            console.log(\"EchartsPie 提取到的 timeValues:\", timeValuesRaw);\n\n            // *** 转换数据格式为饼图需要的 [{value, name}, ...] ***\n            const pieData = timeValuesRaw.map((value, index) => {\n              return {\n                value: value,\n                name: MONTH_NAMES[index], // 使用预定义的月份名称\n              };\n            });\n            // *** 格式转换结束 ***\n\n            console.log(\n              \"EchartsPie 转换后的饼图数据:\",\n              JSON.stringify(pieData)\n            );\n\n            if (this.chartInstance) {\n              // 更新图表数据\n              this.chartInstance.setOption({\n                // (可选) 如果图例数据也需要动态更新（比如月份不固定）\n                // legend: {\n                //   data: pieData.map(item => item.name)\n                // },\n                series: [\n                  {\n                    // 只需要更新 data\n                    data: pieData,\n                  },\n                ],\n              });\n              console.log(\"EchartsPie: 饼图数据已更新\");\n            }\n          } else {\n            this.error = \"未能从服务器获取有效数据\";\n            console.error(\n              \"EchartsPie: API 返回数据为空或格式不正确:\",\n              response.data\n            );\n          }\n        })\n        .catch((error) => {\n          this.error = \"加载数据失败\";\n          console.error(\"EchartsPie: 请求错误:\", error);\n        })\n        .finally(() => {\n          this.isLoading = false;\n        });\n    },\n\n    handleResize() {\n      if (this.chartInstance) {\n        setTimeout(() => {\n          if (this.chartInstance) {\n            this.chartInstance.resize();\n          }\n        }, 200);\n      }\n    },\n  },\n};\n</script>\n\n<style scoped>\n/* Add styles for .loading-message if needed */\n.error-message {\n  padding: 10px;\n  color: red;\n  text-align: center;\n}\n</style>\n"]}]}