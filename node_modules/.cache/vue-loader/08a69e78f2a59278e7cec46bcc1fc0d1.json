{"remainingRequest":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/liuyide/Desktop/FitBotWeb/src/components/eCharts.vue?vue&type=style&index=0&id=5a0a438c&scoped=true&lang=css","dependencies":[{"path":"/Users/liuyide/Desktop/FitBotWeb/src/components/eCharts.vue","mtime":1743867243222},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/css-loader/index.js","mtime":1743054314550},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":1743054315691},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/postcss-loader/src/index.js","mtime":1743054315143},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js","mtime":1743054315359}],"contextDependencies":[],"result":["\n.error-message {\n  color: red;\n}\n",{"version":3,"sources":["eCharts.vue"],"names":[],"mappings":";AAmNA;AACA;AACA","file":"eCharts.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <!-- 1. 容器 -->\n  <div ref=\"chart\" style=\"width: 35vw; height: 40vh\"></div>\n</template>\n\n<script>\nimport * as echarts from \"echarts\";\nimport axios from \"axios\";\n\nexport default {\n  name: \"echarts\", // 建议给组件一个更具体的名称\n  data() {\n    return {\n      // user_data: [], // 可以移除，直接在 setOption 时使用获取到的数据\n      chartInstance: null, // 用于存储 ECharts 实例\n      isLoading: false, // (可选) 添加加载状态\n      error: null, // (可选) 添加错误状态\n    };\n  },\n  mounted() {\n    // 2. 先初始化图表基本结构\n    this.initChart();\n    // 3. 然后获取数据并更新图表\n    this.fetchAndUpdateChart();\n    // 4. (推荐) 添加窗口大小调整监听\n    window.addEventListener(\"resize\", this.handleResize);\n  },\n  beforeDestroy() {\n    // 5. (推荐) 组件销毁前销毁 ECharts 实例并移除监听\n    if (this.chartInstance) {\n      this.chartInstance.dispose();\n      this.chartInstance = null;\n    }\n    window.removeEventListener(\"resize\", this.handleResize);\n  },\n  methods: {\n    // 初始化图表方法\n    initChart() {\n      const chartDom = this.$refs.chart;\n      if (chartDom && !this.chartInstance) {\n        // 确保 DOM 存在且实例未初始化\n        this.chartInstance = echarts.init(chartDom);\n\n        // 定义初始的、不含具体数据的配置项\n        const initialOption = {\n          title: {\n            text: \"用户运动准确率\", // 可以设置一个更合适的标题\n          },\n          tooltip: {\n            trigger: \"axis\", // 坐标轴触发提示框\n          },\n          xAxis: {\n            data: [\n              // X 轴标签保持不变\n              \"JAN\",\n              \"FEB\",\n              \"MAR\",\n              \"APR\",\n              \"MAY\",\n              \"JUN\",\n              \"JUL\",\n              \"AUG\",\n              \"SEP\",\n              \"OCT\",\n              \"NOV\",\n              \"DEC\",\n            ],\n            splitLine: {\n              show: true, // 确认显示 Y 轴网格线 (水平线)\n            },\n          },\n          yAxis: {\n            min: 0, // 根据你的数据（准确率）设置合理的范围\n            max: 1,\n            type: \"value\",\n            axisLabel: {\n              color: \"#000000\", // 设置 y 轴标签文字颜色为白色\n            },\n            splitLine: {\n              show: true, // 确认显示 Y 轴网格线 (水平线)\n            },\n            axisLine: {\n              show: true, // 显示Y轴线\n              lineStyle: {\n                color: \"#000000\", // 设置 y 轴线颜色为白色\n              },\n            },\n          },\n          series: [\n            {\n              name: \"准确率\", // 系列名称\n              type: \"bar\", // 柱状图\n              data: [], // 初始数据为空，等待加载\n              itemStyle: {\n                // 可以设置柱状图颜色等\n                color: \"#4e73df\", // 例如，设置一个蓝色\n              },\n            },\n          ],\n          grid: {\n            // 调整图表在容器内的边距\n            left: \"3%\",\n            right: \"4%\",\n            bottom: \"3%\",\n            containLabel: true, // 防止标签溢出\n          },\n        };\n\n        // 使用初始配置项渲染图表框架\n        this.chartInstance.setOption(initialOption);\n      } else if (!chartDom) {\n        console.error(\"图表容器 'chart' 未找到!\");\n      }\n    },\n\n    // 获取数据并更新图表的方法\n    fetchAndUpdateChart() {\n      if (this.isLoading) return; // 防止重复请求\n      this.isLoading = true;\n      this.error = null;\n\n      const userEmail = sessionStorage.getItem(\"email\");\n      if (!userEmail) {\n        console.error(\"无法从 sessionStorage 获取 email\");\n        this.error = \"未找到用户信息\";\n        this.isLoading = false;\n        // 可以选择在这里清空图表或显示提示\n        // if(this.chartInstance) this.chartInstance.setOption({ series: [{data: []}] });\n        return; // 终止执行\n      }\n\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/getUserMInf.php\",\n          { email: userEmail },\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          console.log(\"Response:\", response.data); // 打印整个返回数据以便调试\n          if (response.data && response.data.length > 0) {\n            const res_data = response.data[0];\n\n            // 提取 accuracy 数据 - 确保顺序正确或 API 返回有序\n            // 如果 API 不能保证 accuracy_1, accuracy_2... 的顺序，需要排序\n            const accuracyValues = Object.keys(res_data)\n              // 匹配 accuracy_ 开头，后跟数字的键\n              .filter((key) => /^accuracy_\\d+$/.test(key))\n              // (可选) 如果需要按数字排序\n              .sort((a, b) => {\n                const numA = parseInt(a.split(\"_\")[1], 10);\n                const numB = parseInt(b.split(\"_\")[1], 10);\n                return numA - numB;\n              })\n              // 提取对应的值，并确保是数字类型\n              .map((key) => parseFloat(res_data[key]) || 0); // 使用 parseFloat 并提供默认值 0\n\n            console.log(\"提取到的 Accuracy 数据:\", accuracyValues);\n\n            // 确保我们有 ECharts 实例\n            if (this.chartInstance) {\n              // 更新图表数据\n              this.chartInstance.setOption({\n                series: [\n                  {\n                    // 这里只需要提供要更新的数据部分\n                    data: accuracyValues,\n                  },\n                ],\n                // (可选) 如果标题也需要根据数据更新\n                // title: {\n                //   text: `${userEmail} 的月度准确率`\n                // }\n              });\n              console.log(\"图表数据已更新\");\n            }\n          } else {\n            console.error(\"API 返回数据为空或格式不正确:\", response.data);\n            this.error = \"未能从服务器获取有效数据\";\n            // (可选) 清空图表\n            // if(this.chartInstance) this.chartInstance.setOption({ series: [{data: []}] });\n          }\n        })\n        .catch((error) => {\n          console.error(\"请求错误:\", error);\n          this.error = \"加载数据失败，请稍后重试\";\n          // (可选) 清空图表\n          // if(this.chartInstance) this.chartInstance.setOption({ series: [{data: []}] });\n        })\n        .finally(() => {\n          this.isLoading = false; // 无论成功失败，结束加载状态\n        });\n    },\n\n    // 处理窗口大小变化，调整图表\n    handleResize() {\n      if (this.chartInstance) {\n        // 添加一个小的延迟，等待容器尺寸稳定后再调整\n        // 因为 resize 事件可能触发非常频繁\n        setTimeout(() => {\n          if (this.chartInstance) {\n            // 再次检查实例是否存在\n            this.chartInstance.resize();\n          }\n        }, 200); // 200ms 延迟\n      }\n    },\n  },\n};\n</script>\n\n<style scoped>\n.error-message {\n  color: red;\n}\n</style>\n"]}]}