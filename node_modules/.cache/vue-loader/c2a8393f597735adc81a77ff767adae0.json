{"remainingRequest":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/liuyide/Desktop/FitBotWeb/src/pages/TableList.vue?vue&type=script&lang=js","dependencies":[{"path":"/Users/liuyide/Desktop/FitBotWeb/src/pages/TableList.vue","mtime":1747061012915},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/babel-loader/lib/index.js","mtime":1743054315148},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/cache-loader/dist/cjs.js","mtime":1743054315026},{"path":"/Users/liuyide/Desktop/FitBotWeb/node_modules/vue-loader/lib/index.js","mtime":1743054315359}],"contextDependencies":[],"result":["\nimport { Card } from \"@/components/index\";\nimport BaseTable from \"@/components/BaseTable\";\nimport axios from \"axios\";\n\nexport default {\n  name: \"YourComponentName\",\n  components: {\n    Card,\n    BaseTable,\n    // ElDrawer: Drawer,\n  },\n  data() {\n    return {\n      own_comment: false,\n      user_comment: \"\",\n      commitInf: [],\n      drawer: false,\n      selectedArticle: null,\n      table1: {\n        title: \"简单表格\",\n        columns: [\"title\", \"intro\", \"commit_num\"],\n        data: [],\n      },\n    };\n  },\n  beforeMount() {\n    this.fetchTable1Data();\n  },\n  methods: {\n    delete_comment(comment_id) {\n      this.$confirm(\"\", \"此操作将永久删除该评论, 是否继续?\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\",\n      })\n        .then(() => {\n          axios\n            .post(\n              \"https://www.lloydyide.cn/fitbotAPI/deleteChat.php\",\n              {\n                chat_id: comment_id,\n                article_id: this.selectedArticle.id,\n                commit_num: Number(this.selectedArticle.commit_num) - 1,\n              },\n              {\n                headers: {\n                  \"Content-Type\": \"application/x-www-form-urlencoded\",\n                },\n              }\n            )\n            .then((response) => {\n              console.log(\"delete success\", response);\n              this.commitInf = this.commitInf.filter(\n                (item) => item.id !== comment_id\n              );\n              this.selectedArticle.commit_num =\n                Number(this.selectedArticle.commit_num) - 1;\n            })\n            .catch((error) => {\n              console.error(\"获取数据时出错:\", error);\n            });\n          this.$message({\n            type: \"success\",\n            message: \"删除成功!\",\n          });\n        })\n        .catch(() => {\n          this.$message({\n            type: \"info\",\n            message: \"已取消删除\",\n          });\n        });\n      console.log(comment_id);\n    },\n    likeComment(id, star) {\n      console.log(id); //评论id\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/likeCommit.php\",\n          {\n            email: sessionStorage.getItem(\"email\"),\n            id,\n            star,\n          },\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          console.log(response.data);\n          this.getChat(this.selectedArticle.id);\n          if (response.data === 0) {\n            this.$message.success(\"点赞成功\");\n          } else {\n            this.$message.success(\"取消点赞成功\");\n          }\n        });\n    },\n    sendComment() {\n      // 判断评论是否有暴力危险嫌疑，通过后上传\n      axios\n        .post(\"http://172.20.10.4:5001/predict\", {\n          text: this.user_comment,\n        })\n        .then((response) => {\n          console.log(response.data.result); //prediction\n          if (response.data.prediction === 1) {\n            this.$message.error(\"评论检测为有害！\");\n          } else {\n            const today = new Date();\n            const year = today.getFullYear();\n            const month = (today.getMonth() + 1).toString().padStart(2, \"0\");\n            const day = today.getDate().toString().padStart(2, \"0\");\n            const currentDate = `${year}-${month}-${day}`;\n            axios\n              .post(\n                \"https://www.lloydyide.cn/fitbotAPI/uploadChat.php\",\n                {\n                  article_id: this.selectedArticle.id,\n                  content: this.user_comment,\n                  user_id: sessionStorage.getItem(\"email\"),\n                  date: currentDate,\n                  location: \"上海\",\n                  user_name: sessionStorage.getItem(\"name\"),\n                  commit_num: Number(this.selectedArticle.commit_num) + 1,\n                },\n                {\n                  headers: {\n                    \"Content-Type\": \"application/x-www-form-urlencoded\",\n                  },\n                }\n              )\n              .then((response) => {\n                console.log(response.data);\n                this.user_comment = \"\";\n                this.getChat(this.selectedArticle.id);\n                this.selectedArticle.commit_num =\n                  Number(this.selectedArticle.commit_num) + 1;\n              })\n              .catch((error) => {\n                console.error(\"获取数据时出错:\", error);\n              });\n          }\n        })\n        .catch((error) => {\n          console.error(\"请求失败:\", error);\n        });\n    },\n    judgeComment() {\n      if (!sessionStorage.getItem(\"name\")) {\n        this.$message.error(\"请先登陆\");\n      } else if (!this.user_comment.length) {\n        this.$message.error(\"请先说些什么\");\n      } else {\n        this.sendComment();\n      }\n\n      // 根据IP获取城市 太慢\n      // axios\n      //   .post(\n      //     \"http://ip-api.com/json/124.79.86.8\",\n      //     {},\n      //     { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n      //   )\n      //   .then((response) => {\n      //     console.log(response.data.regionName);\n      //   })\n      //   .catch((error) => {\n      //     console.error(\"获取数据时出错:\", error);\n      //   });\n    },\n    fetchTable1Data() {\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/getArticleInf.php\",\n          {},\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          if (Array.isArray(response.data)) {\n            this.table1.data = response.data;\n          } else {\n            console.error(\"API 返回的不是数组:\", response.data);\n            this.table1.data = [];\n          }\n        })\n        .catch((error) => {\n          console.error(\"获取表格数据时出错:\", error);\n          this.table1.data = [];\n        });\n    },\n    getChat(id) {\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/getChat.php\",\n          {\n            id,\n          },\n          {\n            headers: {\n              \"Content-Type\": \"application/x-www-form-urlencoded\",\n            },\n          }\n        )\n        .then((response) => {\n          console.log(response.data);\n          this.commitInf = [...response.data].sort((a, b) => b.id - a.id);\n          this.commitInf.forEach((item) => {\n            const isOwn = item.user_id === sessionStorage.getItem(\"email\");\n            this.$set(item, \"is_own\", isOwn);\n          });\n        })\n        .catch((error) => {\n          console.error(\"获取数据时出错:\", error);\n        });\n    },\n    // 在父组件的 <script> methods 中\n    handleRowClick(item) {\n      console.log(\"点击的行数据:\", item); // <--- 添加这行来查看数据\n      this.selectedArticle = item;\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/getArticlePic.php\",\n          {\n            id: item.id,\n          },\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          this.selectedArticle.imageUrls = response.data;\n          console.log(this.selectedArticle.imageUrls[0].pic_url);\n          this.getChat(item.id);\n        })\n        .catch((error) => {\n          console.error(\"获取数据时出错:\", error);\n        });\n      this.drawer = true;\n    },\n  },\n};\n",{"version":3,"sources":["TableList.vue"],"names":[],"mappings":";AAoKA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"TableList.vue","sourceRoot":"src/pages","sourcesContent":["<template>\n  <div class=\"content\">\n    <div class=\"row\">\n      <div class=\"col-12\">\n        <card style=\"height: 86vh; overflow: scroll\">\n          <template slot=\"header\">\n            <h4 class=\"card-title\">文章列表</h4>\n          </template>\n          <div class=\"table-responsive text-left\">\n            <base-table\n              :data=\"table1.data\"\n              :columns=\"table1.columns\"\n              thead-classes=\"text-primary\"\n              @row-click=\"handleRowClick\"\n            >\n            </base-table>\n          </div>\n        </card>\n      </div>\n\n      <el-drawer\n        :withHeader=\"false\"\n        :visible.sync=\"drawer\"\n        direction=\"ttb\"\n        size=\"100%\"\n        :append-to-body=\"true\"\n        custom-class=\"article-detail-drawer\"\n      >\n        <!-- 确保 selectedArticle 有数据后再渲染内部结构 -->\n        <div v-if=\"selectedArticle\" class=\"drawer-layout\">\n          <!-- 关闭按钮 -->\n          <el-button\n            type=\"info\"\n            icon=\"el-icon-close\"\n            circle\n            class=\"close-button\"\n            @click=\"drawer = false\"\n          ></el-button>\n          <div class=\"image-pane\">\n            <el-carousel\n              :interval=\"5000\"\n              arrow=\"always\"\n              height=\"100%\"\n              class=\"image-carousel\"\n              ref=\"imageCarousel\"\n            >\n              <el-carousel-item\n                v-for=\"(imgUrl, index) in selectedArticle.imageUrls\"\n                :key=\"index\"\n              >\n                <!-- 让图片填充轮播项，并保持比例 -->\n                <img\n                  :src=\"imgUrl.pic_url\"\n                  :alt=\"'文章图片 ' + imgUrl\"\n                  class=\"carousel-image\"\n                />\n              </el-carousel-item>\n            </el-carousel>\n          </div>\n\n          <!-- 右侧内容和评论区域 -->\n          <div class=\"details-pane\">\n            <!-- 上部：内容 -->\n            <div class=\"content-section\">\n              <h3 style=\"font-weight: bolder\">{{ selectedArticle.title }}</h3>\n              <div class=\"content-text-area\">\n                {{ selectedArticle.content }}\n              </div>\n            </div>\n\n            <!-- 下部：评论 -->\n            <div class=\"comments-section\">\n              <h5 style=\"color: black\">\n                共{{ selectedArticle.commit_num }}条评论：\n              </h5>\n\n              <div>\n                <el-input\n                  placeholder=\"说点什么...\"\n                  v-model=\"user_comment\"\n                  class=\"input-with-select\"\n                >\n                  <el-button\n                    slot=\"append\"\n                    icon=\"el-icon-s-promotion\"\n                    @click=\"judgeComment\"\n                    >发送</el-button\n                  >\n                </el-input>\n              </div>\n\n              <div class=\"comments-list-area\">\n                <!-- 替换 selectedArticle.comments 为你的实际评论数组属性 -->\n                <ul\n                  v-if=\"Array.isArray(commitInf) && commitInf.length > 0\"\n                  class=\"comment-list\"\n                >\n                  <li\n                    v-for=\"(comment, index) in commitInf\"\n                    :key=\"index\"\n                    class=\"comment-item\"\n                  >\n                    <!-- 左侧内容区 (占位较多) -->\n                    <div class=\"comment-left\">\n                      <div class=\"comment-user\">\n                        {{ comment.user_name || \"匿名用户\" }}\n                      </div>\n                      <div class=\"comment-content\">\n                        {{ comment.content }}\n                      </div>\n                      <div class=\"comment-meta\">\n                        <span class=\"comment-date\">{{ comment.date }}</span>\n                        <span v-if=\"comment.location\" class=\"comment-location\">\n                          · {{ comment.location }}</span\n                        >\n                        <span\n                          style=\"\n                            margin-left: 1vw;\n                            color: #ff6b6b;\n                            cursor: pointer;\n                          \"\n                          v-if=\"comment.is_own\"\n                          @click=\"delete_comment(comment.id)\"\n                          >删除</span\n                        >\n                      </div>\n                    </div>\n\n                    <!-- 右侧点赞区 (占位较少) -->\n                    <div class=\"comment-right\">\n                      <span class=\"comment-star\">\n                        <i\n                          class=\"el-icon-star-on\"\n                          style=\"color: #ffc107; font-size: 2rem\"\n                          @click=\"\n                            likeComment(\n                              commitInf[index].id,\n                              commitInf[index].star\n                            )\n                          \"\n                        ></i>\n                        {{ comment.star }}\n                      </span>\n                    </div>\n                  </li>\n                </ul>\n                <p v-else class=\"no-comments\">暂无评论</p>\n              </div>\n            </div>\n\n            <!-- 建议将以下 CSS 添加到你的 <style> 标签或 CSS 文件中 -->\n          </div>\n        </div>\n\n        <!-- selectedArticle 为空时的占位提示 -->\n        <div v-else class=\"drawer-placeholder\">\n          <p>请先在表格中选择一篇文章以查看详情。</p>\n        </div>\n      </el-drawer>\n    </div>\n  </div>\n</template>\n\n<script>\nimport { Card } from \"@/components/index\";\nimport BaseTable from \"@/components/BaseTable\";\nimport axios from \"axios\";\n\nexport default {\n  name: \"YourComponentName\",\n  components: {\n    Card,\n    BaseTable,\n    // ElDrawer: Drawer,\n  },\n  data() {\n    return {\n      own_comment: false,\n      user_comment: \"\",\n      commitInf: [],\n      drawer: false,\n      selectedArticle: null,\n      table1: {\n        title: \"简单表格\",\n        columns: [\"title\", \"intro\", \"commit_num\"],\n        data: [],\n      },\n    };\n  },\n  beforeMount() {\n    this.fetchTable1Data();\n  },\n  methods: {\n    delete_comment(comment_id) {\n      this.$confirm(\"\", \"此操作将永久删除该评论, 是否继续?\", {\n        confirmButtonText: \"确定\",\n        cancelButtonText: \"取消\",\n        type: \"warning\",\n      })\n        .then(() => {\n          axios\n            .post(\n              \"https://www.lloydyide.cn/fitbotAPI/deleteChat.php\",\n              {\n                chat_id: comment_id,\n                article_id: this.selectedArticle.id,\n                commit_num: Number(this.selectedArticle.commit_num) - 1,\n              },\n              {\n                headers: {\n                  \"Content-Type\": \"application/x-www-form-urlencoded\",\n                },\n              }\n            )\n            .then((response) => {\n              console.log(\"delete success\", response);\n              this.commitInf = this.commitInf.filter(\n                (item) => item.id !== comment_id\n              );\n              this.selectedArticle.commit_num =\n                Number(this.selectedArticle.commit_num) - 1;\n            })\n            .catch((error) => {\n              console.error(\"获取数据时出错:\", error);\n            });\n          this.$message({\n            type: \"success\",\n            message: \"删除成功!\",\n          });\n        })\n        .catch(() => {\n          this.$message({\n            type: \"info\",\n            message: \"已取消删除\",\n          });\n        });\n      console.log(comment_id);\n    },\n    likeComment(id, star) {\n      console.log(id); //评论id\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/likeCommit.php\",\n          {\n            email: sessionStorage.getItem(\"email\"),\n            id,\n            star,\n          },\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          console.log(response.data);\n          this.getChat(this.selectedArticle.id);\n          if (response.data === 0) {\n            this.$message.success(\"点赞成功\");\n          } else {\n            this.$message.success(\"取消点赞成功\");\n          }\n        });\n    },\n    sendComment() {\n      // 判断评论是否有暴力危险嫌疑，通过后上传\n      axios\n        .post(\"http://172.20.10.4:5001/predict\", {\n          text: this.user_comment,\n        })\n        .then((response) => {\n          console.log(response.data.result); //prediction\n          if (response.data.prediction === 1) {\n            this.$message.error(\"评论检测为有害！\");\n          } else {\n            const today = new Date();\n            const year = today.getFullYear();\n            const month = (today.getMonth() + 1).toString().padStart(2, \"0\");\n            const day = today.getDate().toString().padStart(2, \"0\");\n            const currentDate = `${year}-${month}-${day}`;\n            axios\n              .post(\n                \"https://www.lloydyide.cn/fitbotAPI/uploadChat.php\",\n                {\n                  article_id: this.selectedArticle.id,\n                  content: this.user_comment,\n                  user_id: sessionStorage.getItem(\"email\"),\n                  date: currentDate,\n                  location: \"上海\",\n                  user_name: sessionStorage.getItem(\"name\"),\n                  commit_num: Number(this.selectedArticle.commit_num) + 1,\n                },\n                {\n                  headers: {\n                    \"Content-Type\": \"application/x-www-form-urlencoded\",\n                  },\n                }\n              )\n              .then((response) => {\n                console.log(response.data);\n                this.user_comment = \"\";\n                this.getChat(this.selectedArticle.id);\n                this.selectedArticle.commit_num =\n                  Number(this.selectedArticle.commit_num) + 1;\n              })\n              .catch((error) => {\n                console.error(\"获取数据时出错:\", error);\n              });\n          }\n        })\n        .catch((error) => {\n          console.error(\"请求失败:\", error);\n        });\n    },\n    judgeComment() {\n      if (!sessionStorage.getItem(\"name\")) {\n        this.$message.error(\"请先登陆\");\n      } else if (!this.user_comment.length) {\n        this.$message.error(\"请先说些什么\");\n      } else {\n        this.sendComment();\n      }\n\n      // 根据IP获取城市 太慢\n      // axios\n      //   .post(\n      //     \"http://ip-api.com/json/124.79.86.8\",\n      //     {},\n      //     { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n      //   )\n      //   .then((response) => {\n      //     console.log(response.data.regionName);\n      //   })\n      //   .catch((error) => {\n      //     console.error(\"获取数据时出错:\", error);\n      //   });\n    },\n    fetchTable1Data() {\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/getArticleInf.php\",\n          {},\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          if (Array.isArray(response.data)) {\n            this.table1.data = response.data;\n          } else {\n            console.error(\"API 返回的不是数组:\", response.data);\n            this.table1.data = [];\n          }\n        })\n        .catch((error) => {\n          console.error(\"获取表格数据时出错:\", error);\n          this.table1.data = [];\n        });\n    },\n    getChat(id) {\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/getChat.php\",\n          {\n            id,\n          },\n          {\n            headers: {\n              \"Content-Type\": \"application/x-www-form-urlencoded\",\n            },\n          }\n        )\n        .then((response) => {\n          console.log(response.data);\n          this.commitInf = [...response.data].sort((a, b) => b.id - a.id);\n          this.commitInf.forEach((item) => {\n            const isOwn = item.user_id === sessionStorage.getItem(\"email\");\n            this.$set(item, \"is_own\", isOwn);\n          });\n        })\n        .catch((error) => {\n          console.error(\"获取数据时出错:\", error);\n        });\n    },\n    // 在父组件的 <script> methods 中\n    handleRowClick(item) {\n      console.log(\"点击的行数据:\", item); // <--- 添加这行来查看数据\n      this.selectedArticle = item;\n      axios\n        .post(\n          \"https://www.lloydyide.cn/fitbotAPI/getArticlePic.php\",\n          {\n            id: item.id,\n          },\n          { headers: { \"Content-Type\": \"application/x-www-form-urlencoded\" } }\n        )\n        .then((response) => {\n          this.selectedArticle.imageUrls = response.data;\n          console.log(this.selectedArticle.imageUrls[0].pic_url);\n          this.getChat(item.id);\n        })\n        .catch((error) => {\n          console.error(\"获取数据时出错:\", error);\n        });\n      this.drawer = true;\n    },\n  },\n};\n</script>\n\n<style>\n/* 为抽屉添加一个自定义类，方便进行样式覆盖和限定范围 */\n:deep {\n  padding: 0; /* 移除 Element UI 默认的 body padding */\n  overflow: hidden; /* 防止内部元素溢出导致滚动条出现问题 */\n  height: 100%;\n  display: flex; /* 使用 flex 布局 */\n}\n\n.drawer-layout {\n  position: relative; /* 父容器需要相对定位，以便绝对定位的子元素相对于它定位 */\n  display: flex;\n  flex-direction: row;\n  width: 100%;\n  height: 100%;\n  background-color: #f8f9fa;\n}\n\n.close-button {\n  position: absolute; /* 使用绝对定位 */\n  top: 20px; /* 距离顶部 20px */\n  left: 20px; /* 距离左侧 20px */\n  z-index: 10; /* 确保按钮在其他内容之上 */\n}\n/* 左侧图片面板 */\n.image-pane {\n  flex: 0 0 50%; /* 保持原有的宽度设置 */\n  padding: 4.5vw; /* 可以适当减少内边距，给轮播图更多空间 */\n  box-sizing: border-box;\n  display: flex; /* 仍然使用flex来居中占位符 */\n  align-items: center;\n  justify-content: center;\n  overflow: hidden; /* 防止轮播图溢出 */\n  border-right: 1px solid #dee2e6;\n  position: relative; /* 添加相对定位，如果需要绝对定位内部元素 */\n}\n\n.image-carousel {\n  width: 100%; /* 轮播图宽度占满 image-pane */\n  height: 100%; /* 轮播图高度占满 image-pane */\n}\n\n/* 设置轮播图中图片本身的样式 */\n.carousel-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block; /* 消除图片下方的微小间隙 */\n  border-radius: 6px; /* 给图片加点圆角 */\n}\n/* 调整箭头按钮 */\n:deep(.image-carousel) {\n  background-color: rgba(31, 45, 61, 0.7); /* 半透明背景 */\n  width: 40px;\n  height: 40px;\n  font-size: 18px;\n}\n:deep(.image-carousel) {\n  left: 15px; /* 调整左箭头位置 */\n}\n:deep(.image-carousel) {\n  right: 15px; /* 调整右箭头位置 */\n}\n/* 调整指示器 */\n:deep(.image-carousel) {\n  bottom: 10px; /* 指示器距离底部距离 */\n}\n:deep(.image-carousel .el-carousel__indicator button) {\n  background-color: #ced4da; /* 指示器非激活颜色 */\n  opacity: 0.8;\n  width: 10px; /* 可以调小一点 */\n  height: 10px;\n  border-radius: 50%;\n}\n:deep(.image-carousel .el-carousel__indicator.is-active button) {\n  background-color: #007bff; /* 指示器激活颜色 */\n  opacity: 1;\n}\n.image-placeholder {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #adb5bd; /* 占位文字颜色 */\n  background-color: #e9ecef; /* 占位背景色 */\n  border-radius: 8px;\n  font-size: 1.2em;\n}\n\n/* 右侧详情面板 */\n.details-pane {\n  flex: 0 0 50%; /* 固定宽度为50% */\n  display: flex;\n  flex-direction: column; /* 垂直排列：上内容下评论 */\n  height: 100%;\n  overflow: hidden; /* 防止内部滚动影响外部 */\n}\n\n/* 内容区域 */\n.content-section {\n  /* flex-grow: 1; 让内容区尽可能填充空间，但要考虑最小高度 */\n  padding: 25px; /* 增加内边距 */\n  box-sizing: border-box;\n  overflow-y: auto; /* 内容过多时允许滚动 */\n  flex-shrink: 0; /* 防止被评论区过度压缩 */\n  border-bottom: 1px solid #dee2e6; /* 底部边框分割线 */\n  background-color: #ffffff; /* 内容区白色背景 */\n}\n\n.content-section h3 {\n  margin-top: 0;\n  margin-bottom: 15px;\n  color: #343a40;\n  font-size: 1.4em;\n}\n\n.content-text-area {\n  line-height: 1.6;\n  color: #495057;\n}\n\n/* 评论区域 */\n.comments-section {\n  flex-grow: 1; /* 占据剩余空间 */\n  padding: 25px;\n  box-sizing: border-box;\n  overflow-y: auto; /* 评论过多时允许滚动 */\n  display: flex; /* 使用flex布局方便控制内部滚动 */\n  flex-direction: column; /* 垂直排列标题和列表 */\n}\n\n.comments-section h3 {\n  margin-bottom: 20px;\n  color: #333;\n  border-bottom: 1px solid #eee;\n  padding-bottom: 10px;\n}\n\n.comment-list {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\n/* --- 单条评论样式 --- */\n.comment-item {\n  display: flex; /* 启用 Flexbox 布局 */\n  justify-content: space-between; /* 两侧内容分开 */\n  padding: 15px 0; /* 上下内边距 */\n  border-bottom: 1px dashed #e0e0e0; /* 评论之间的分隔线 */\n}\n\n.comment-item:last-child {\n  border-bottom: none; /* 最后一条评论不需要分隔线 */\n}\n\n/* --- 评论左侧 --- */\n.comment-left {\n  flex: 1; /* 占据剩余空间 (大致 80% 效果) */\n  padding-right: 15px; /* 与右侧点赞区隔开 */\n  display: flex;\n  flex-direction: column; /* 内部元素垂直排列 */\n}\n\n.comment-user {\n  font-weight: bold;\n  color: #007bff; /* 用户名颜色 */\n  margin-bottom: 5px;\n  font-size: 0.95em;\n}\n\n.comment-content {\n  color: #444; /* 评论内容颜色 */\n  line-height: 1.6;\n  margin-bottom: 8px;\n  word-wrap: break-word; /* 长单词或链接换行 */\n}\n\n.comment-meta {\n  font-size: 0.8em; /* 元信息字体小一点 */\n  color: #888; /* 元信息颜色浅一点 */\n}\n\n.comment-date {\n  margin-right: 5px;\n}\n\n.comment-location {\n  /* 可选：给地点加个小图标 */\n  /* content: \"\\f3c5\";  -- FontAwesome 示例 */\n  /* font-family: \"Font Awesome 5 Free\"; */\n  /* font-weight: 900; */\n  /* margin-right: 3px; */\n}\n\n/* --- 评论右侧 --- */\n.comment-right {\n  flex: 0 0 60px; /* 固定宽度 (大致 20% 效果，可调整)，不伸缩 */\n  display: flex;\n  align-items: center; /* 垂直居中对齐 */\n  justify-content: center; /* 水平居中对齐 */\n  text-align: center;\n}\n\n.comment-star {\n  display: flex;\n  flex-direction: column; /* 图标和数字垂直排列 */\n  align-items: center;\n  color: #666;\n  font-size: 0.9em;\n}\n\n/* --- 无评论提示 --- */\n.no-comments {\n  text-align: center;\n  color: #999;\n  padding: 20px 0;\n}\n\n.no-comments {\n  color: #6c757d;\n  font-style: italic;\n}\n\n/* selectedArticle 为空时的占位符样式 */\n.drawer-placeholder {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #6c757d;\n  font-size: 1.1em;\n  text-align: center;\n  padding: 20px;\n  box-sizing: border-box;\n}\n</style>\n"]}]}