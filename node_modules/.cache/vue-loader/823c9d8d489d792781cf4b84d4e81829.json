= false\"\n        ></el-button>\n        <div class=\"image-pane\">\n          <el-carousel\n            v-if=\"\n              Array.isArray(selectedArticle.imageUrls) &&\n              selectedArticle.imageUrls.length > 0\n            \"\n            :interval=\"5000\"\n            arrow=\"always\"\n            height=\"100%\"\n            class=\"image-carousel\"\n            ref=\"imageCarousel\"\n          >\n            <el-carousel-item\n              v-for=\"(imgUrl, index) in selectedArticle.imageUrls\"\n              :key=\"index\"\n            >\n              <!-- 让图片填充轮播项，并保持比例 -->\n              <img\n                :src=\"imgUrl\"\n                :alt=\"'文章图片 ' + (index + 1)\"\n                class=\"carousel-image\"\n              />\n            </el-carousel-item>\n          </el-carousel>\n\n          <!-- 如果没有有效的图片数组，则显示占位符 -->\n          <div v-else class=\"image-placeholder\">无图片</div>\n        </div>\n\n        <!-- 右侧内容和评论区域 -->\n        <div class=\"details-pane\">\n          <!-- 上部：内容 -->\n          <div class=\"content-section\">\n            <h3>文章内容</h3>\n            <div class=\"content-text-area\">\n              <!-- 替换 selectedArticle.content 为你的实际内容属性 -->\n              <p v-if=\"selectedArticle.content\">\n                {{ selectedArticle.content }}\n              </p>\n              <p v-else>暂无内容</p>\n            </div>\n          </div>\n\n          <!-- 下部：评论 -->\n          <div class=\"comments-section\">\n            <h3>评论区</h3>\n            <div class=\"comments-list-area\">\n              <!-- 替换 selectedArticle.comments 为你的实际评论数组属性 -->\n              <ul\n                v-if=\"\n                  Array.isArray(selectedArticle.comments) &&\n                  selectedArticle.comments.length > 0\n                \"\n                class=\"comment-list\"\n              >\n                <!-- 假设评论对象有 author 和 text 属性, 请按需替换 -->\n                <li\n                  v-for=\"(comment, index) in selectedArticle.comments\"\n                  :key=\"index\"\n                  class=\"comment-item\"\n                >\n                  <p>\n                    <strong>{{ comment.author || \"匿名用户\" }}:</strong>\n                    {{ comment.text }}\n                  </p>\n                </li>\n              </ul>\n              <p\n                v-else-if=\"\n                  typeof selectedArticle.comments === 'string' &&\n                  selectedArticle.comments.trim()\n                \"\n              >\n                {{ selectedArticle.comments }}\n              </p>\n              <p v-else class=\"no-comments\">暂无评论</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- selectedArticle 为空时的占位提示 -->\n      <div v-else class=\"drawer-placeholder\">\n        <p>请先在表格中选择一篇文章以查看详情。</p>\n      </div>\n    </el-drawer>\n  </div>\n</div>\n",null]}